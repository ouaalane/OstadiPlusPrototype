{
  "expo": {
    "name": "oustadi plus",
    "slug": "ostadiplus-student",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "ostadiplus",
    "userInterfaceStyle": "light",
    "primaryColor": "#68234F",
    "backgroundColor": "#F1E9F4",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ma.atlas.ostadiplus.student"
    },
    "android": {
      "package": "ma.atlas.ostadiplus.student",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#68234F",
        "backgroundImage": "./assets/adaptive-background.png",
        "monochromeImage": "./assets/adaptive-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Autoriser oustadi plus à sélectionner une photo de profil.",
          "cameraPermission": false,
          "microphonePermission": false,
          "colors": {
            "cropToolbarColor": "#68234F",
            "cropToolbarIconColor": "#FFFFFF",
            "cropToolbarActionTextColor": "#FFFFFF",
            "cropBackgroundColor": "#F1E9F4"
          }
        }
      ],
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "PORTRAIT_UP"
        }
      ],
      "expo-video",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#68234F",
          "defaultChannel": "lessons"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#F1E9F4"
        }
      ],
      "expo-asset",
      "expo-status-bar",
      "./plugins/withCaptureProtection"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
