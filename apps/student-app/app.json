{
  "expo": {
    "name": "OstadiPlus",
    "slug": "ostadiplus-student",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "ostadiplus",
    "userInterfaceStyle": "light",
    "primaryColor": "#0B5CFF",
    "backgroundColor": "#F3F9FD",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ma.atlas.ostadiplus.student"
    },
    "android": {
      "package": "ma.atlas.ostadiplus.student",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-video",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0B5CFF",
          "defaultChannel": "lessons"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/adaptive-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#F3F9FD"
        }
      ],
      "expo-asset",
      "expo-status-bar"
    ]
  }
}
