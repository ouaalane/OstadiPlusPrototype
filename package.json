{
  "name": "ostadiplus",
  "version": "1.0.0",
  "private": true,
  "description": "OstadiPlus — interactive product prototype (teacher dashboard + student Android app)",
  "workspaces": [
    "packages/*",
    "apps/teacher-dashboard"
  ],
  "scripts": {
    "dashboard": "npm run dev -w @ostadiplus/teacher-dashboard",
    "dashboard:build": "npm run build -w @ostadiplus/teacher-dashboard",
    "app": "npm run start --prefix apps/student-app",
    "app:android": "npm run android --prefix apps/student-app",
    "api": "node apps/api/src/main.mjs",
    "api:trace": "node apps/api/src/trace.mjs",
    "media": "node scripts/generate-media.mjs",
    "media:fetch": "node scripts/fetch-videos.mjs",
    "media:pdfs": "node scripts/media/import-pdfs.mjs",
    "media:sync": "node scripts/sync-media.mjs",
    "demo": "node apps/api/src/main.mjs --demo",
    "dashboard:test": "node scripts/check-quiz-authoring.mjs && node scripts/check-teacher-workspace.mjs && node scripts/check-authoring-ux.mjs && node scripts/check-dashboard-ux.mjs && node scripts/check-student-access-ux.mjs && node scripts/check-communication-ux.mjs && node scripts/check-lesson-editor-ui.mjs && node scripts/check-dashboard-languages.mjs",
    "access:test": "node scripts/check-access.mjs",
    "test:journeys": "node scripts/check-student-codes.mjs && node scripts/check-app-journeys.mjs",
    "invitations:test": "node scripts/check-center-invitations.mjs && node scripts/check-app-journeys.mjs"
  },
  "devDependencies": {
    "pdf-to-img": "^7.0.1",
    "pdfjs-dist": "^6.4.299",
    "playwright": "^1.64.0",
    "typescript": "^5.9.3"
  }
}
